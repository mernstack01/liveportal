# deploy/.env ga nusxalang va to'ldiring. Bu fayl git'ga tushmaydi (.gitignore).

# Portal domeni (DNS A yozuvi server IP'siga qaraydi). WEB_ORIGIN = https://DOMAIN avtomatik.
DOMAIN=portal.itlive.uz

# Faqat harf va raqam bo'lsin (URL ichida ishlatiladi): openssl rand -hex 24
POSTGRES_PASSWORD=

# Kamida 32 belgi: openssl rand -hex 32
JWT_SECRET=

# @BotFather. Lokal dev bot bilan BIR XIL token ishlatmang: ikkala joy polling qilsa, Telegram 409 beradi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_MODE=polling

# Ertalabki xulosa soati (Toshkent)
DIGEST_HOUR=9
