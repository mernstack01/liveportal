// LivePortal — ma'lumotlar bazasi sxemasi.
// Domen modeli: docs/03-domain-model.md. MVP-0 da Channel/Message/TaskDependency uchun kod yozilmaydi (docs/09).

// Prisma 7: ulanish URL'i prisma.config.ts da, client esa adapter (@prisma/adapter-pg) bilan.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity & access ─────────────

model User {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?  @unique
  telegramId       BigInt?  @unique
  telegramUsername String?
  avatarUrl        String?
  onboarding       String[] @default([]) // ko'rib bo'lingan yo'riqnomalar (walkthrough): 'welcome', 'project', ...
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspaces        WorkspaceMember[]
  projects          ProjectMember[]
  taskAssignments   TaskAssignee[]
  reportedIncidents Incident[]        @relation("incidentReporter")
  ownedIncidents    Incident[]        @relation("incidentOwner")
  incidentUpdates   IncidentUpdate[]
  ownedDeals        Deal[]            @relation("dealOwner")
  createdDeals      Deal[]            @relation("dealCreator")
  dealActivities    DealActivity[]
  reportedTasks     Task[]            @relation("reporter")
  comments          Comment[]
  messages          Message[]
  notifications     Notification[]
  sessions          Session[]
  invitesCreated    Invite[]          @relation("inviteCreator")
  invitesUsed       Invite[]          @relation("inviteUser")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}") // feature flags, til, default workflow ...
  createdAt DateTime @default(now())

  members     WorkspaceMember[]
  roles       Role[]
  projects    Project[]
  channels    Channel[]
  rules       NotificationRule[]
  events      Event[]
  invites     Invite[]
  deals       Deal[]
  /// Kelishuv raqamlari (K-1, K-2 ...) workspace bo'yicha.
  dealCounter Int                @default(0)
}

model Role {
  id          String    @id @default(cuid())
  workspaceId String
  name        String // kalit: owner, admin, teamlead, developer, guest yoki yaratilgan rolning slug'i
  title       String? // interfeysdagi nomi: "Dasturchi", "QA muhandis" ...
  scope       RoleScope
  permissions String[] // ['project.create', 'task.assign', ...]
  isSystem    Boolean   @default(false)

  workspace        Workspace             @relation(fields: [workspaceId], references: [id])
  workspaceMembers WorkspaceMember[]
  extraMembers     WorkspaceMemberRole[]
  projectMembers   ProjectMember[]
  invites          Invite[]

  @@unique([workspaceId, name])
}

enum RoleScope {
  WORKSPACE
  PROJECT
}

model WorkspaceMember {
  workspaceId String
  userId      String
  roleId      String
  joinedAt    DateTime @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id])
  user       User                  @relation(fields: [userId], references: [id])
  role       Role                  @relation(fields: [roleId], references: [id])
  extraRoles WorkspaceMemberRole[]

  @@id([workspaceId, userId])
}

/// Qo'shimcha workspace rollari (masalan "Savdo"): ruxsatlar asosiy rol bilan qo'shiladi.
model WorkspaceMemberRole {
  workspaceId String
  userId      String
  roleId      String
  assignedAt  DateTime @default(now())

  member WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)
  role   Role            @relation(fields: [roleId], references: [id])

  @@id([workspaceId, userId, roleId])
  @@index([roleId])
}

/// Taklif havolasi: t.me/<bot>?start=inv_<token>. Faqat taklif qilingan odam tizimga kira oladi.
model Invite {
  id          String    @id @default(cuid())
  workspaceId String
  roleId      String // workspace darajasidagi rol
  tokenHash   String    @unique // token o'zi saqlanmaydi, faqat sha256
  note        String? // kim uchun: "Aziz, backend mentor"
  createdById String?
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  role      Role      @relation(fields: [roleId], references: [id])
  createdBy User?     @relation("inviteCreator", fields: [createdById], references: [id])
  usedBy    User?     @relation("inviteUser", fields: [usedById], references: [id])
}

/// Refresh token sessiyasi. Token o'zi emas, sha256 xeshi saqlanadi; har refresh'da almashtiriladi.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Projects & tasks ─────────────

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  key             String // "LP" -> LP-1, LP-2 ...
  name            String
  description     String?
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?
  dueDate         DateTime?
  customFields    Json          @default("{}")
  taskCounter     Int           @default(0)
  incidentCounter Int           @default(0) // INC-1, INC-2 ... loyiha ichida
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  members   ProjectMember[]
  statuses  WorkflowStatus[]
  tasks     Task[]
  channels  Channel[]
  incidents Incident[]

  @@unique([workspaceId, key])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  projectId String
  userId    String
  roleId    String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([projectId, userId])
}

model WorkflowStatus {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory // dashboard shu bo'yicha hisoblaydi
  color     String?
  order     Int

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELED
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  number       Int // LP-<number>
  title        String
  description  String?
  statusId     String
  priority     Priority  @default(MEDIUM)
  type         TaskType  @default(TASK)
  reporterId   String
  parentId     String? // kichik vazifa (subtask) bo'lsa — ota task; faqat bir daraja
  dueDate      DateTime? // kun (UTC yarim tun)
  dueTime      String? // ixtiyoriy soat "HH:MM", Toshkent vaqti. Bor bo'lsa, muddat aynan shu daqiqada tugaydi
  estimate     Int? // soat yoki story point — ❓
  customFields Json      @default("{}")
  completedAt  DateTime?
  incidentId   String? // insidentdan yaratilgan bo'lsa (keyingi qadam, tuzatish)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project   Project          @relation(fields: [projectId], references: [id])
  incident  Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  status    WorkflowStatus   @relation(fields: [statusId], references: [id])
  reporter  User             @relation("reporter", fields: [reporterId], references: [id])
  parent    Task?            @relation("subtasks", fields: [parentId], references: [id])
  subtasks  Task[]           @relation("subtasks")
  comments  Comment[]
  assignees TaskAssignee[] // bir nechta mas'ul (Bitrix24: mas'ul + ijrochilar)
  blocks    TaskDependency[] @relation("from")
  blockedBy TaskDependency[] @relation("to")

  @@unique([projectId, number])
  @@index([dueDate])
  @@index([incidentId])
  @@index([parentId])
}

/// Jira'dagidek task turi: oddiy ish, xato (bug) yoki yangi funksiya.
enum TaskType {
  TASK
  BUG
  FEATURE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskDependency {
  fromTaskId String
  toTaskId   String
  type       String @default("blocks")

  from Task @relation("from", fields: [fromTaskId], references: [id])
  to   Task @relation("to", fields: [toTaskId], references: [id])

  @@id([fromTaskId, toTaskId])
}

model Comment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  mentions  String[] // userId'lar
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])
}

// ───────────── Incidents ─────────────

/// Loyihada nosozlik (sayt ishlamay qoldi, to'lov o'tmayapti...). Task emas: hozir yonayotgan muammo,
/// holati va xronologiyasi (timeline) bilan. Hal qilingach "sabab va yechim" yoziladi.
model Incident {
  id          String           @id @default(cuid())
  projectId   String
  number      Int // INC-<number>
  title       String
  description String?
  severity    IncidentSeverity @default(SEV3)
  status      IncidentStatus   @default(OPEN)
  reporterId  String
  ownerId     String? // mas'ul (incident commander)
  startedAt   DateTime         @default(now()) // muammo qachon boshlangan
  resolvedAt  DateTime?
  resolution  String? // sabab va yechim (postmortem qisqa)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project          @relation(fields: [projectId], references: [id])
  reporter User             @relation("incidentReporter", fields: [reporterId], references: [id])
  owner    User?            @relation("incidentOwner", fields: [ownerId], references: [id])
  updates  IncidentUpdate[]
  tasks    Task[] // insidentdan kelib chiqqan ishlar

  @@unique([projectId, number])
  @@index([projectId, status])
}

enum IncidentSeverity {
  SEV1 // kritik: hamma ishlamayapti
  SEV2 // jiddiy: asosiy funksiya buzilgan
  SEV3 // o'rtacha: qisman, aylanib o'tish yo'li bor
  SEV4 // kichik
}

enum IncidentStatus {
  OPEN // yangi, hali hech kim olmagan
  INVESTIGATING // tekshirilmoqda
  MONITORING // tuzatildi, kuzatilmoqda
  RESOLVED
}

/// Insident xronologiyasi: qo'lda yozilgan yangilanish yoki avtomatik yozuv (holat, daraja, mas'ul o'zgardi).
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  authorId   String
  kind       String // 'created' | 'note' | 'status' | 'severity' | 'owner' | 'task'
  body       String   @default("")
  from       String?
  to         String?
  createdAt  DateTime @default(now())

  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[] // skrinshot, log fayl

  @@index([incidentId, createdAt])
}

// ───────────── Communication ─────────────

model Channel {
  id              String      @id @default(cuid())
  workspaceId     String
  projectId       String?
  type            ChannelType
  name            String
  telegramChatId  BigInt? // bog'langan TG guruh
  telegramTopicId Int? // forum topic
  createdAt       DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  messages  Message[]
}

enum ChannelType {
  INTERNAL
  EXTERNAL
  DIRECT
  ANNOUNCEMENT
}

model Message {
  id             String        @id @default(cuid())
  channelId      String
  authorId       String? // tashqi odam bo'lsa null bo'lishi mumkin
  externalAuthor Json? // { name, telegramId } — ro'yxatdan o'tmagan tashqi foydalanuvchi
  body           String
  source         MessageSource @default(PORTAL)
  replyToId      String?
  createdAt      DateTime      @default(now())
  editedAt       DateTime? // muallif tahrirlagan bo'lsa

  channel     Channel      @relation(fields: [channelId], references: [id])
  author      User?        @relation(fields: [authorId], references: [id])
  attachments Attachment[]
}

/// Chatga biriktirilgan fayl. Fayl diskda (UPLOAD_DIR/storageKey), bazada faqat ma'lumoti.
model Attachment {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String? // kelishuv fayllarida yo'q (kelishuv loyihadan oldin bo'ladi)
  messageId        String?
  incidentUpdateId String? // insident xronologiyasidagi yangilanishga biriktirilgan
  dealActivityId   String? // kelishuv tarixidagi yozuvga (shartnoma, chek, TZ)
  uploaderId       String
  fileName         String // asl nomi (ko'rsatish uchun)
  mimeType         String // baytlardan aniqlangan rasm turi yoki yuklagan bergani
  kind             String // 'image' (brauzerda ochiladi) | 'file' (faqat yuklab olinadi)
  size             Int
  storageKey       String   @unique
  createdAt        DateTime @default(now())

  message        Message?        @relation(fields: [messageId], references: [id])
  incidentUpdate IncidentUpdate? @relation(fields: [incidentUpdateId], references: [id], onDelete: Cascade)
  dealActivity   DealActivity?   @relation(fields: [dealActivityId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([incidentUpdateId])
  @@index([dealActivityId])
}

enum MessageSource {
  PORTAL
  TELEGRAM
}

// ───────────── Events & notifications ─────────────

/// Har bir domen hodisasi. Outbox sifatida ham ishlaydi (publishedAt = null → hali yuborilmagan).
model Event {
  id          String    @id @default(cuid())
  workspaceId String
  type        String // 'task.assigned', 'project.created' ...
  actorId     String?
  entityType  String
  entityId    String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  notifications Notification[]

  @@index([entityType, entityId])
  @@index([publishedAt])
}

model NotificationRule {
  id          String   @id @default(cuid())
  workspaceId String
  eventType   String // 'task.overdue'
  conditions  Json     @default("{}") // { priority: ['HIGH','URGENT'] }
  recipients  Json // { roles: ['teamlead'], fields: ['assignee'] }
  channels    String[] // ['telegram', 'in_app']
  enabled     Boolean  @default(true)

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  eventId       String
  channel       String // 'telegram' | 'in_app' | 'email' ...
  kind          String // 'assigned' | 'mentioned' | 'commented' | 'review' | 'added' — matn shablonini tanlaydi
  status        String    @default("pending") // pending | sent | failed
  attempts      Int       @default(0)
  // Navbat: shu vaqtdan keyin yuboriladi. Olingan qator 5 daqiqaga "band" qilinadi (process yiqilsa qaytadi).
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  // Event qayta yetkazilsa ham bitta odamga bitta xabar.
  @@unique([eventId, userId, channel])
  @@index([userId, readAt])
  @@index([status, nextAttemptAt])
}

/// Kuniga (yoki boshqa davrga) bir marta bajariladigan ishlar: ertalabki digest, overdue tekshiruvi.
/// (job, period) qatori ishning o'zi bilan bitta tranzaksiyada yoziladi: bir nechta API nusxasida ham bir marta.
model JobRun {
  job       String // 'morning'
  period    String // '2026-11-15' (Toshkent sanasi)
  createdAt DateTime @default(now())
  stats     Json     @default("{}")

  @@id([job, period])
}

/// Taskning mas'ullari: bir nechta odam birga javobgar bo'lishi mumkin.
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
}

/// Kelishuv (savdo): loyiha boshlanishidan oldingi jarayon — so'rovdan avansgacha. Yutilsa, loyihaga aylanadi.
/// Faqat `deal.manage` (o'zi mas'ul bo'lganlari) va `deal.view_all` (hammasi) ko'radi.
model Deal {
  id              String     @id @default(cuid())
  workspaceId     String
  number          Int // K-<number>
  title           String
  clientName      String
  clientContact   String? // telefon, @telegram, ...
  source          DealSource @default(OTHER)
  description     String? // nima so'rayapti (ish hajmi)
  amount          Decimal?   @db.Decimal(14, 2)
  currency        Currency   @default(UZS)
  stage           DealStage  @default(NEW)
  ownerId         String? // mas'ul (savdochi)
  createdById     String
  /// Keyingi qadam: har faol kelishuvda majburiy. Vaqti o'tsa — mas'ulga, 24 soatdan keyin rahbarga xabar.
  nextStep        String?
  nextStepAt      DateTime?
  stepRemindedAt  DateTime?
  stepEscalatedAt DateTime?
  dueDate         DateTime?  @db.Date // mijoz kutayotgan topshirish sanasi; o'zgartirish — sabab bilan
  lostReason      String?
  stageChangedAt  DateTime   @default(now())
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  owner      User?          @relation("dealOwner", fields: [ownerId], references: [id])
  createdBy  User           @relation("dealCreator", fields: [createdById], references: [id])
  activities DealActivity[]

  @@unique([workspaceId, number])
  @@index([workspaceId, stage])
  @@index([ownerId])
}

enum DealStage {
  NEW // yangi so'rov
  DISCUSSION // muhokama
  PROPOSAL // taklif yuborildi
  CONTRACT // shartnoma
  ADVANCE // avans kutilmoqda
  WON // yutildi (loyiha ochildi)
  LOST // yo'qotildi
}

enum DealSource {
  TELEGRAM
  INSTAGRAM
  REFERRAL // tanish orqali
  WEBSITE
  CALL
  OTHER
}

enum Currency {
  UZS
  USD
}

/// Kelishuv tarixi: qo'ng'iroq, uchrashuv, izoh (fayllar bilan) va avtomatik yozuvlar (bosqich, mas'ul, muddat...).
model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  authorId  String?
  /// created | note | call | meeting | stage | owner | step | due | amount
  kind      String
  body      String?
  from      String?
  to        String?
  createdAt DateTime @default(now())

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([dealId, createdAt])
}
