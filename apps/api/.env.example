# Lokal ishlab chiqish qiymatlari (docker-compose.yml bilan mos). Production'da boshqa.
NODE_ENV=development
PORT=4100

DATABASE_URL=postgresql://liveportal:liveportal_dev@127.0.0.1:5434/liveportal
REDIS_URL=redis://127.0.0.1:6381

# Web (Vite) manzili: CORS va bot xabarlaridagi havola uchun
WEB_ORIGIN=http://localhost:5173

# JWT imzosi. Yaratish: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

# Telegram bot: tokenni @BotFather beradi. Bu faylga emas, faqat .env ga yozing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# off | polling
BOT_MODE=polling

# Faqat lokal: Telegram Login Widget localhost'da ishlamaydi, shuning uchun telegramId bilan kirish.
DEV_LOGIN=true

# Outbox eventlarini tarqatish oralig'i (ms). 0 — o'chiq.
OUTBOX_POLL_MS=2000
# Telegram bildirishnomalari navbati (ms). 0 — o'chiq.
NOTIFY_POLL_MS=1000
